# KE-WP Mapping Application Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
HOST=127.0.0.1

# GitHub OAuth Configuration
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Database Configuration
DATABASE_PATH=ke_wp_mapping.db

# Admin Users (comma-separated, supports provider prefix e.g. github:alice,orcid:0000-...)
ADMIN_USERS=yourusername,otheradmin

# Optional: Rate Limiting
# Storage backend for Flask-Limiter (guards the /api/v1 blueprint only).
RATELIMIT_STORAGE_URL=memory://

# Optional: per-hour ceilings for the built-in SQLite limiter, keyed on
# (client IP, endpoint). Defaults below match the historical hardcoded values;
# a missing, non-numeric or non-positive value falls back to the default.
# Raise SUBMISSION_RATE_LIMIT_PER_HOUR for a bulk curation sprint — at 20/h a few
# hundred proposals take most of a day, and rejected requests count too.
# Read at import time, so a change needs a restart.
# SUBMISSION_RATE_LIMIT_PER_HOUR=20   # /submit*, /admin/*/approve, guest login
# SPARQL_RATE_LIMIT_PER_HOUR=500      # /suggest_*, /search_*, /get_ke_options
# GENERAL_RATE_LIMIT_PER_HOUR=1000    # /check_*_entry and friends

# Zenodo Dataset Publication (Phase 5)
# Get token from: Zenodo Dashboard -> Settings -> Applications -> Personal access tokens
# Required scope: deposit:write
ZENODO_API_TOKEN=your-zenodo-api-token-here

# Optional: Additional OAuth Providers (activate by setting both ID and SECRET)
# ORCID: Register at https://orcid.org/developer-tools
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# LS Login: Register at https://login.elixir-czech.org
LS_CLIENT_ID=
LS_CLIENT_SECRET=

# SURFconext: Register at https://dashboard.surfconext.nl
SURF_CLIENT_ID=
SURF_CLIENT_SECRET=
